{
  "name": "@cozycodr/lipila-store-postgres",
  "version": "0.0.0-development",
  "description": "PostgreSQL lifecycle store adapter for Lipila",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --clean --external pg && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:integration": "vitest run test/postgres.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cozycodr/lipila-store-core": "0.0.0-development"
  },
  "peerDependencies": {
    "@cozycodr/lipila": ">=0.0.0-development <1",
    "pg": ">=8.13.0 <9"
  },
  "devDependencies": {
    "@cozycodr/lipila": "0.0.0-development",
    "@cozycodr/lipila-store-conformance": "0.0.0-development",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.6",
    "pg": "^8.16.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "homepage": "https://lipilasdk.oapps.dev",
  "bugs": {
    "url": "https://github.com/cozyCodr/lipila-sdks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cozyCodr/lipila-sdks.git",
    "directory": "sdks/store-postgres"
  }
}
